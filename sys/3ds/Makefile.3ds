# ==============================================================================
# NetHack 5.0 - Nintendo 3DS Makefile
# ==============================================================================

ifeq ($(strip $(DEVKITPRO)),)
  DEVKITPRO := C:/devkitPro
endif

ifeq ($(strip $(DEVKITARM)),)
  DEVKITARM := $(DEVKITPRO)/devkitARM
endif

CTRULIB   := $(DEVKITPRO)/libctru
3DSXTOOL  := $(DEVKITPRO)/tools/bin/3dsxtool
SMDHTOOL  := $(DEVKITPRO)/tools/bin/smdhtool
MAKEROM   := $(DEVKITPRO)/tools/bin/makerom
BANNERTOOL := $(DEVKITPRO)/tools/bin/bannertool

HOSTCC    := C:/msys64/ucrt64/bin/gcc.exe
CC        := $(DEVKITARM)/bin/arm-none-eabi-gcc
AR        := $(DEVKITARM)/bin/arm-none-eabi-ar

ARCH      := -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft
SPECS     := -specs=$(DEVKITARM)/arm-none-eabi/lib/3dsx.specs

BUILD     := build3ds
ROMFS_DIR := romfs

# -I$(BUILD) is where the generated sndpack.h lands (see sys/3ds/build_sounds.py)
INCLUDES  := -Iinclude -Inhlua/lua/src -I$(CTRULIB)/include -I$(BUILD) -Isys/3ds
DEFINES   := -D__3DS__ -DARM11 -DCROSSCOMPILE -DCROSSCOMPILE_TARGET -DNINTENDO_3DS \
             -DTILES_IN_GLYPHMAP -DUSE_PNG

CFLAGS    := -std=gnu11 -O2 -Wall -Wno-unused-function -Wno-unused-variable \
             -MMD -MP -ffunction-sections -fdata-sections \
             $(ARCH) $(INCLUDES) $(DEFINES)

LDFLAGS   := $(SPECS) $(ARCH) -Wl,--gc-sections -L$(CTRULIB)/lib \
             -Wl,--wrap=write -Wl,--wrap=read -Wl,--wrap=lseek -Wl,--wrap=close
LIBS      := -lctru -lm


# ------------------------------------------------------------------------------
# Launcher / Home Menu metadata
#
# The icon is a 48x48 PNG at sys/3ds/icon.png (drop one in there; the libctru
# placeholder is used until you do).  bannertool makesmdh (with smdhtool as a
# fallback) packs it into the SMDH, which the 3DS scales up for the 96x96 Home
# Menu icon.  The same metadata goes into the 3DSX (Homebrew Launcher) and into
# the CIA (Home Menu), so both show the same name.
# ------------------------------------------------------------------------------
APP_TITLE  := NetHack for 3DS
APP_DESC   := NetHack 5.0 for Nintendo 3DS
APP_AUTHOR := ran4erep
APP_RSF    := sys/3ds/nethack.rsf

APP_ICON := $(firstword $(wildcard sys/3ds/icon.png) \
                       $(wildcard sys/3ds/icon_48.png) \
                       $(CTRULIB)/default_icon.png)

# Home Menu banner.  A CGFX banner (a real 3D scene, rotated by the Home Menu)
# is preferred when sys/3ds/banner.cgfx exists.  Otherwise the old 256x128 PNG
# is used.  bannertool insists on an audio track: use sys/3ds/banner.wav when
# present, otherwise the silent placeholder.  The Home Menu expects 44.1 kHz,
# 16-bit stereo and at most 3 seconds, so a real WAV is converted into the
# build directory with ffmpeg.  Both banner forms are optional: without a
# banner (or without bannertool) the CIA is still built, just with no banner.
BANNER_PNG     := $(firstword $(wildcard sys/3ds/banner.png) \
                             $(wildcard sys/3ds/banner_256x128.png))
BANNER_CGFX    := $(firstword $(wildcard sys/3ds/banner.cgfx))
BANNER_GLB     := $(firstword $(wildcard sys/3ds/banner.glb))
BANNER_SILENCE := sys/3ds/banner_silence.wav
BANNER_AUDIO_SRC := $(firstword $(wildcard sys/3ds/banner.wav) $(BANNER_SILENCE))
# ffmpeg is needed to convert music / the banner audio and the mp3 sound
# pack.  Auto-detect the usual install locations first, then fall back to
# whatever "ffmpeg" resolves to on PATH so a build never silently ships
# without sound.
FFMPEG         := $(or $(firstword $(wildcard C:/ffmpeg/ffmpeg.exe \
                                             /c/ffmpeg/ffmpeg.exe \
                                             $(DEVKITPRO)/msys2/usr/bin/ffmpeg.exe \
                                             $(DEVKITPRO)/msys2/mingw64/bin/ffmpeg.exe \
                                             $(DEVKITPRO)/tools/bin/ffmpeg.exe)), \
                       ffmpeg)
FFMPEG_OK      := $(shell command -v $(FFMPEG) 2>/dev/null)
ifeq ($(filter sys/3ds/banner.wav,$(BANNER_AUDIO_SRC)),)
  BANNER_AUDIO := $(BANNER_AUDIO_SRC)
else ifeq ($(FFMPEG_OK),)
  BANNER_AUDIO := $(BANNER_AUDIO_SRC)
else
  BANNER_AUDIO := $(BUILD)/banner_audio.wav
endif
BANNERTOOL_OK  := $(shell if [ -f "$(BANNERTOOL)" ] || [ -f "$(BANNERTOOL).exe" ]; then echo 1; fi)
SMDHTOOL_OK    := $(shell if [ -f "$(SMDHTOOL)" ] || [ -f "$(SMDHTOOL).exe" ]; then echo 1; fi)

ifeq ($(BANNER_CGFX),)
  BANNER_SOURCE := $(BANNER_PNG)
  BANNER_ARGS   := -i $(BANNER_PNG)
  BANNER_KIND   := png
  SMDH_FLAGS    := visible,allow3d,recordusage
else
  BANNER_SOURCE := $(BANNER_CGFX)
  BANNER_ARGS   := -ci $(BANNER_CGFX)
  BANNER_KIND   := cgfx
  # extendedbanner is what tells the Home Menu to use the CGFX scene instead
  # of the flat image.  bannertool is required for this flag (smdhtool cannot
  # set it), which is why the SMDH is generated with bannertool below.
  SMDH_FLAGS    := visible,allow3d,recordusage,extendedbanner
endif

ifeq ($(BANNERTOOL_OK),)
  ifneq ($(BANNER_SOURCE),)
    $(warning bannertool not found in $(DEVKITPRO)/tools/bin - $(BANNER_SOURCE) will not be packed into the CIA)
  endif
endif

BANNER_BIN := $(if $(and $(BANNERTOOL_OK),$(BANNER_SOURCE)),$(BUILD)/banner.bnr)

ifeq ($(BANNERTOOL_OK),1)
  SMDH_CMD := $(BANNERTOOL) makesmdh -s "$(APP_TITLE)" -l "$(APP_DESC)" \
              -p "$(APP_AUTHOR)" -i "$(APP_ICON)" -r regionfree \
              -f "$(SMDH_FLAGS)" -o
else
  ifeq ($(SMDHTOOL_OK),1)
    SMDH_CMD := $(SMDHTOOL) --create "$(APP_TITLE)" "$(APP_DESC)" \
                "$(APP_AUTHOR)" "$(APP_ICON)"
  else
    SMDH_CMD := @echo "neither bannertool nor smdhtool found"; false
  endif
endif

# ------------------------------------------------------------------------------
# Core NetHack source files
# ------------------------------------------------------------------------------
CORE_SRCS := \
	src/allmain.c src/alloc.c src/apply.c src/artifact.c src/attrib.c \
	src/ball.c src/bones.c src/botl.c src/calendar.c src/cfgfiles.c src/coloratt.c \
	src/cmd.c src/date.c src/dbridge.c src/decl.c src/detect.c src/dig.c \
	src/display.c src/dlb.c src/do.c src/do_name.c src/do_wear.c src/dog.c \
	src/dogmove.c src/dokick.c src/dothrow.c src/drawing.c src/dungeon.c \
	src/earlyarg.c src/eat.c src/end.c src/engrave.c src/exper.c \
	src/explode.c src/extralev.c src/files.c src/fountain.c src/getpos.c \
	src/glyphs.c src/hack.c src/hacklib.c src/iactions.c src/insight.c \
	src/invent.c src/isaac64.c src/light.c src/lock.c src/mail.c \
	src/makemon.c src/mcastu.c src/mdlib.c src/mhitm.c src/mhitu.c \
	src/minion.c src/mklev.c src/mkmap.c src/mkmaze.c src/mkobj.c \
	src/mkroom.c src/mon.c src/mondata.c src/monmove.c src/monst.c \
	src/mplayer.c src/mthrowu.c src/muse.c src/music.c src/nhlobj.c \
	src/nhlsel.c src/nhlua.c src/nhmd4.c src/objects.c src/objnam.c \
	src/options.c src/o_init.c src/pager.c src/pickup.c src/pline.c \
	src/polyself.c src/potion.c src/pray.c src/priest.c src/quest.c \
	src/questpgr.c src/read.c src/rect.c src/region.c src/report.c \
	src/restore.c src/revision.c src/rip.c src/rnd.c src/role.c src/rumors.c src/save.c \
	src/selvar.c src/sfbase.c src/sfstruct.c src/shk.c src/shknam.c \
	src/sit.c src/sounds.c src/spell.c src/sp_lev.c src/stairs.c \
	src/steal.c src/steed.c src/strutil.c src/symbols.c src/sys.c \
	src/teleport.c src/timeout.c src/topten.c src/track.c src/trap.c \
	src/uhitm.c src/utf8map.c src/u_init.c src/vault.c src/version.c \
	src/vision.c src/weapon.c src/were.c src/wield.c src/windows.c \
	src/wizard.c src/wizcmds.c src/worm.c src/worn.c src/write.c src/zap.c \
	src/tile.c

TTY_SRCS := \
	win/tty/getline.c win/tty/termcap.c win/tty/topl.c win/tty/wintty.c

SYS_SRCS := \
	sys/share/pcmain.c sys/share/pcsys.c sys/share/pcunix.c \
	sys/share/pmatchregex.c sys/3ds/3dsmain.c sys/3ds/3dstty.c \
	sys/3ds/3dstiles.c sys/3ds/3dsui.c sys/3ds/3dsart.c \
	sys/3ds/3dsart_data.c sys/3ds/3dspng.c sys/3ds/puff.c \
	sys/3ds/3dsled.c sys/3ds/3dssnd.c sys/3ds/youhear.c \
	sys/3ds/3dslevelmem.c \
	sys/3ds/3dsfont_data.c sys/3ds/3dsfont.c sys/3ds/3dsi18n.c

# Portable tile readers/writers shared with other ports (see win/share/).
SHARE_SRCS := \
	win/share/bmptiles.c win/share/giftiles.c win/share/tileset.c

LUA_SRCS := \
	nhlua/lua/src/lapi.c nhlua/lua/src/lauxlib.c nhlua/lua/src/lbaselib.c \
	nhlua/lua/src/lcode.c nhlua/lua/src/lcorolib.c nhlua/lua/src/lctype.c \
	nhlua/lua/src/ldblib.c nhlua/lua/src/ldebug.c nhlua/lua/src/ldo.c \
	nhlua/lua/src/ldump.c nhlua/lua/src/lfunc.c nhlua/lua/src/lgc.c \
	nhlua/lua/src/linit.c nhlua/lua/src/liolib.c nhlua/lua/src/llex.c \
	nhlua/lua/src/lmathlib.c nhlua/lua/src/lmem.c nhlua/lua/src/loadlib.c \
	nhlua/lua/src/lobject.c nhlua/lua/src/lopcodes.c nhlua/lua/src/loslib.c \
	nhlua/lua/src/lparser.c nhlua/lua/src/lstate.c nhlua/lua/src/lstring.c \
	nhlua/lua/src/lstrlib.c nhlua/lua/src/ltable.c nhlua/lua/src/ltablib.c \
	nhlua/lua/src/ltm.c nhlua/lua/src/lundump.c nhlua/lua/src/lutf8lib.c \
	nhlua/lua/src/lvm.c nhlua/lua/src/lzio.c

CORE_OBJS := $(patsubst src/%.c, $(BUILD)/src/%.o, $(CORE_SRCS))
TTY_OBJS  := $(patsubst win/tty/%.c, $(BUILD)/win/%.o, $(TTY_SRCS))
SYS_OBJS  := $(patsubst sys/share/%.c, $(BUILD)/sys/%.o, \
             $(patsubst sys/3ds/%.c, $(BUILD)/sys/%.o, $(SYS_SRCS)))
SHARE_OBJS := $(patsubst win/share/%.c, $(BUILD)/share/%.o, $(SHARE_SRCS))
LUA_OBJS  := $(patsubst nhlua/lua/src/%.c, $(BUILD)/lua/%.o, $(LUA_SRCS))

ALL_OBJS  := $(CORE_OBJS) $(TTY_OBJS) $(SYS_OBJS) $(SHARE_OBJS) $(LUA_OBJS)
DEPS      := $(ALL_OBJS:.o=.d)

# Header dependencies generated by -MMD -MP.  Without these, header-only
# changes (for example sndprocs.h gaining the Soundeffect() macro) silently
# left stale objects compiled against the old definitions.
-include $(DEPS)

# ------------------------------------------------------------------------------
# Build Rules
# ------------------------------------------------------------------------------
.PHONY: all clean host-tools data tiles 3dsx cia banner-cgfx sounds

all: nethack.3dsx nethack.cia

# 1. Host tools
util/makedefs.exe: util/makedefs.c src/alloc.c src/date.c src/monst.c src/objects.c util/panic.c src/hacklib.c
	@echo "[HOST-CC] $@"
	@$(HOSTCC) -O2 -Iinclude -Inhlua/lua/src -DCROSSCOMPILE -DENUM_PM $^ -o $@

util/dlb.exe: src/dlb.c util/dlb_main.c src/alloc.c util/panic.c src/hacklib.c
	@echo "[HOST-CC] $@"
	@$(HOSTCC) -O2 -Iinclude -Inhlua/lua/src -DDLB -DDLBLIB $^ -o $@

host-tools: util/makedefs.exe util/dlb.exe

# 2. Data generation
include/date.h: util/makedefs.exe
	@echo "[MAKEDEFS] -v (date.h & options)"
	@cd util && ./makedefs.exe -v

include/onames.h: util/makedefs.exe
	@echo "[MAKEDEFS] -o (onames.h)"
	@cd util && ./makedefs.exe -o

include/pm.h: util/makedefs.exe
	@echo "[MAKEDEFS] -p (pm.h)"
	@cd util && ./makedefs.exe -p

dat/data: util/makedefs.exe
	@echo "[MAKEDEFS] -d (data)"
	@cd util && ./makedefs.exe -d

dat/rumors: util/makedefs.exe
	@echo "[MAKEDEFS] -r (rumors)"
	@cd util && ./makedefs.exe -r

dat/oracles: util/makedefs.exe
	@echo "[MAKEDEFS] -h (oracles)"
	@cd util && ./makedefs.exe -h

dat/bogusmon: util/makedefs.exe
	@echo "[MAKEDEFS] -s (bogusmon, engrave, epitaph)"
	@cd util && ./makedefs.exe -s

dat/nhdat: util/dlb.exe dat/data dat/rumors dat/oracles dat/bogusmon
	@echo "[DLB] Packaging nhdat archive"
	@cd dat && ../util/dlb.exe cfI nhdat dlb.lst
	@if [ -f dat/nhdat501 ]; then cp dat/nhdat501 dat/nhdat; fi

data: include/date.h include/onames.h include/pm.h dat/nhdat

# 3. Object Compilation for 3DS
$(BUILD)/src/%.o: src/%.c | $(BUILD)/src include/date.h include/onames.h include/pm.h
	@echo "[CC] $<"
	@$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/win/%.o: win/tty/%.c | $(BUILD)/win include/date.h include/onames.h include/pm.h
	@echo "[CC] $<"
	@$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/sys/%.o: sys/share/%.c | $(BUILD)/sys include/date.h include/onames.h include/pm.h
	@echo "[CC] $<"
	@$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/sys/%.o: sys/3ds/%.c | $(BUILD)/sys include/date.h include/onames.h include/pm.h
	@echo "[CC] $<"
	@$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/share/%.o: win/share/%.c | $(BUILD)/share include/date.h include/onames.h include/pm.h
	@echo "[CC] $<"
	@$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/lua/%.o: nhlua/lua/src/%.c | $(BUILD)/lua
	@echo "[CC] $<"
	@$(CC) $(CFLAGS) -c $< -o $@

# Create build directories
$(BUILD)/src $(BUILD)/win $(BUILD)/sys $(BUILD)/share $(BUILD)/lua $(ROMFS_DIR):
	@mkdir -p $@

# 4. Linking ELF
$(BUILD)/nethack.elf: $(ALL_OBJS)
	@echo "[LINK] $@"
	@$(CC) $(ALL_OBJS) $(LDFLAGS) $(LIBS) -o $@

# 5. RomFS preparation and 3DSX generation
$(ROMFS_DIR)/nhdat: dat/nhdat | $(ROMFS_DIR)
	@cp dat/nhdat $@
	@if [ -f dat/license ]; then cp dat/license $(ROMFS_DIR)/; fi
	@if [ -f dat/symbols ]; then cp dat/symbols $(ROMFS_DIR)/; fi

$(ROMFS_DIR)/tiles.bmp: src/tiles.bmp | $(ROMFS_DIR)
	@cp src/tiles.bmp $@

$(ROMFS_DIR)/PixelHack.png: sys/3ds/PixelHack.png | $(ROMFS_DIR)
	@cp sys/3ds/PixelHack.png $@

$(ROMFS_DIR)/NetHack.cnf: sys/3ds/NetHack.cnf | $(ROMFS_DIR)
	@cp sys/3ds/NetHack.cnf $@

# ------------------------------------------------------------------------------
# Sound effects
#
# soundpack/manifest.json (and the files it lists) is converted by
# sys/3ds/build_sounds.py into romfs/sounds/** plus the generated key table
# build3ds/sndpack.h, which sys/3ds/3dssnd.c includes.  soundpack/menu.mp3
# becomes the looping romfs/music/menu.wav.  If soundpack/ or ffmpeg is
# missing, the script writes an empty table and the build still works (the
# game is simply silent).  After replacing the pack, regenerate:
#     make -f sys/3ds/Makefile.3ds sounds
# ------------------------------------------------------------------------------
SNDPACK_SRCS := $(wildcard soundpack/manifest.json soundpack/menu.* \
                           soundpack/music/menu.* soundpack/loop.* \
                           soundpack/music/loop.*) \
                $(shell find soundpack -type f -name '*.mp3' 2>/dev/null)
SNDPACK_HDR  := $(BUILD)/sndpack.h

$(SNDPACK_HDR): sys/3ds/build_sounds.py $(SNDPACK_SRCS) | $(BUILD) $(ROMFS_DIR)
	@echo "[SNDPACK] packing sounds -> $(ROMFS_DIR)/sounds and $@"
	@$(PYTHON) sys/3ds/build_sounds.py --soundpack soundpack \
	    --romfs $(ROMFS_DIR) --out $@ --ffmpeg $(FFMPEG)

# the sound engine includes the generated table
$(BUILD)/sys/3dssnd.o: $(SNDPACK_HDR)

$(BUILD)/nethack.smdh: $(APP_ICON) $(BANNER_SOURCE) | $(BUILD)
	@echo "[SMDH] Generating $@ ($(BANNER_KIND) banner, flags: $(SMDH_FLAGS))"
	@$(SMDH_CMD) $@

$(BUILD)/banner_audio.wav: $(BANNER_AUDIO_SRC) | $(BUILD)
	@echo "[FFMPEG] $< -> $@ (44.1 kHz, stereo, 3 s max)"
	@$(FFMPEG) -y -loglevel error -i "$<" -ar 44100 -ac 2 -c:a pcm_s16le -t 3 "$@"

$(BUILD)/banner.bnr: $(BANNER_SOURCE) $(BANNER_AUDIO) | $(BUILD)
	@echo "[BANNERTOOL] Generating $@ ($(BANNER_KIND) banner, audio: $(BANNER_AUDIO))"
	@$(BANNERTOOL) makebanner $(BANNER_ARGS) -a $(BANNER_AUDIO) -o $@

nethack.3dsx: $(BUILD)/nethack.elf $(ROMFS_DIR)/nhdat $(ROMFS_DIR)/tiles.bmp $(ROMFS_DIR)/PixelHack.png $(ROMFS_DIR)/NetHack.cnf $(SNDPACK_HDR) $(BUILD)/nethack.smdh
	@echo "[3DSXTOOL] Generating $@"
	@$(3DSXTOOL) $(BUILD)/nethack.elf $@ --smdh=$(BUILD)/nethack.smdh --romfs=$(ROMFS_DIR)
	@echo "=========================================================="
	@echo " SUCCESS! NetHack for Nintendo 3DS built: $@"
	@echo "=========================================================="

# Installable title: the same ELF and romfs, packed into a CIA that FBI (or
# any title installer) can put on the SD card.  makerom packs $(ROMFS_DIR)
# itself, following RomFs/RootPath in the RSF, so it has to run from the
# repository root (it does; make's working directory is inherited).
# The splash is left in the NCCH logo region (i.e. no -exefslogo): that is
# where systems 5.0 and later look for it, and it is what shows the Nintendo
# 3DS boot screen.
nethack.cia: $(BUILD)/nethack.elf $(BUILD)/nethack.smdh $(APP_RSF) $(BANNER_BIN) \
             $(ROMFS_DIR)/nhdat $(ROMFS_DIR)/tiles.bmp $(ROMFS_DIR)/PixelHack.png \
             $(ROMFS_DIR)/NetHack.cnf $(SNDPACK_HDR)
	@echo "[MAKEROM] Generating $@"
	@if [ ! -f "$(MAKEROM)" ] && [ ! -f "$(MAKEROM).exe" ]; then \
	    echo " makerom not found at $(MAKEROM)"; \
	    echo " install it from https://github.com/3DSGuy/Project_CTR/releases"; \
	    echo " (makerom-v*-win_x86_64.zip -> $(DEVKITPRO)/tools/bin/makerom.exe)"; \
	    rm -f $@; exit 1; \
	fi
	@$(MAKEROM) -f cia -o $@ -elf $(BUILD)/nethack.elf -rsf $(APP_RSF) \
	    -icon $(BUILD)/nethack.smdh $(if $(BANNER_BIN),-banner $(BANNER_BIN)) \
	    -target t
	@echo "=========================================================="
	@echo " SUCCESS! NetHack for Nintendo 3DS installable built: $@"
	@echo "=========================================================="

# "make -f sys/3ds/Makefile.3ds 3dsx" or "... cia" builds just one of them.
3dsx: nethack.3dsx

# "make -f sys/3ds/Makefile.3ds cia" builds just the installable title.
cia: nethack.cia

# Regenerate the CGFX banner from the optimized GLB.  This is deliberately not
# part of the normal build: sys/3ds/banner.cgfx is checked in so a build only
# needs devkitPro, not Python + pycgfx.  Run this after editing banner.glb.
#   make -f sys/3ds/Makefile.3ds banner-cgfx
#
# sys/3ds/banner.glb is the cleaned banner mesh: node transforms baked, UVs
# pre-transformed, centred at X=0/Z=0 and Y=1, 14 units tall, with every
# submesh hanging off a single "COMMON" bone, and already split into submeshes
# small enough for the HOME Menu's 64 KiB per-attribute vertex-stream budget.
# banner.glb is generated with
#   python sys/3ds/build_banner_glb.py --source knight.glb --output sys/3ds/banner.glb \
#       --no-paint --texture-size 256 --gamma 0.6 --brightness 1.0
# i.e. the plain statue: the model's own 2048x2048 photographic texture, its own
# UVs, one material, roughness 1.0.  build_banner_glb.py merges vertices whose
# position, normal and UV are equal (the source stores one corner per face),
# which is lossless and drops the knight from 7263 to 6811 vertices.
#
# convert_banner.py runs pycgfx and stores the texture as 256x256 RGBA4 (128 KiB),
# which puts the CGFX at about 400 KiB, under the Home Menu's 512 KiB limit.
# pycgfx's PBR material is kept untouched - its specular stage is what gives the
# stone its highlights - and the scene light is left at pycgfx's own ambient =
# diffuse = 1, the setting the hardware-tested banners use.
#
# --paint (palette texture + generated triplanar UVs) is experimental: it builds
# and renders correctly off-console, but on real hardware that CGFX freezes the
# Home Menu before the banner appears, so do not ship it.
PYTHON ?= $(if $(wildcard .tools/pycgfx/.venv/Scripts/python.exe),.tools/pycgfx/.venv/Scripts/python.exe,python)
PYCGFX ?= .tools/pycgfx/main.py
banner-cgfx: $(BANNER_GLB)
	@if [ ! -f sys/3ds/banner.glb ]; then \
	    echo "sys/3ds/banner.glb not found"; exit 1; \
	fi
	@if [ ! -f "$(PYCGFX)" ]; then \
	    echo "pycgfx not found at $(PYCGFX)"; \
	    echo "clone https://github.com/skyfloogle/pycgfx and set PYCGFX=..."; \
	    exit 1; \
	fi
	@echo "[PYCGFX] sys/3ds/banner.glb -> sys/3ds/banner.cgfx"
	@$(PYTHON) sys/3ds/convert_banner.py \
	    sys/3ds/banner.glb sys/3ds/banner.cgfx \
	    --pycgfx-root .tools/pycgfx --texture-size 256 --texture-format rgba4
	@$(PYTHON) sys/3ds/verify_banner.py sys/3ds/banner.glb sys/3ds/banner.cgfx
	@size=$$(wc -c < sys/3ds/banner.cgfx); \
	if [ $$size -gt 524288 ]; then \
	    echo "CGFX is $$size bytes; the Home Menu limit is 524288"; \
	    rm -f sys/3ds/banner.cgfx; exit 1; \
	fi; \
	echo "CGFX size: $$size bytes (limit 524288)"

# Optional: regenerate src/tile.c and src/tiles.bmp from the bundled text tile
# art in win/share/*.txt.  This is NOT part of 'all'; it needs the host tools
# (util/tilemap.exe, util/tile2bmp.exe) to already exist.  See util/hostinc for
# helper scripts used to build them.
tiles:
	@echo "[TILES] Regenerating src/tile.c"
	@cd util && ../util/tilemap.exe
	@echo "[TILES] Regenerating src/tiles.bmp"
	@cd util && ../util/tile2bmp.exe ../src/tiles.bmp

# Optional: re-pack the sounds and music after replacing/adding files in
# soundpack/.  The normal build re-runs build_sounds.py whenever the manifest
# or an mp3 changes, but this forces it when the files were swapped in place.
sounds:
	@rm -rf $(ROMFS_DIR)/sounds $(ROMFS_DIR)/music $(SNDPACK_HDR)
	@$(MAKE) -f sys/3ds/Makefile.3ds $(SNDPACK_HDR)

clean:
	@rm -rf $(BUILD) $(ROMFS_DIR) nethack.3dsx nethack.cia nethack.smdh util/makedefs.exe util/dlb.exe
